{
  "manifest_version": 3,
  "name": "옥토 · X 대화 도우미",
  "version": "1.3.0",
  "description": "한국어 X 글을 찾고 GPT·Grok 댓글 초안을 검토·복사하는 개인용 도구",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.x.com/*",
    "https://api.x.ai/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "옥토 사이드바 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.x.com https://api.x.ai https://api.openai.com; base-uri 'none'"
  },
  "key": ""
}
